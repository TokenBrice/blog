{
  "name": "tokenbrice-blog",
  "version": "1.0.0",
  "description": "TokenBrice Blog - Brutally Honest DeFi",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "hugo server --disableFastRender --navigateToChanged",
    "build": "hugo --gc --minify --cleanDestinationDir",
    "typecheck": "tsc --noEmit",
    "validate:frontmatter": "python3 scripts/validate-frontmatter.py",
    "validate:content": "python3 scripts/validate-content-safety.py",
    "validate:site": "python3 scripts/validate-site-output.py",
    "validate:glossary": "python3 scripts/validate-glossary.py",
    "test:validators": "python3 scripts/tests/run_validator_tests.py",
    "push-gate": "bash scripts/push-gate.sh",
    "verify": "npm run push-gate",
    "test:browser": "node scripts/tests/browser-smoke.mjs",
    "lighthouse:ci": "lhci autorun --config=.lighthouserc.json && node scripts/tests/verify-lighthouse-reports.mjs",
    "test:tooling": "node --test scripts/tests/lighthouse-reports.test.mjs"
  },
  "author": "TokenBrice",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenBrice/blog.git"
  },
  "bugs": {
    "url": "https://github.com/TokenBrice/blog/issues"
  },
  "homepage": "https://github.com/TokenBrice/blog#readme",
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "lighthouse": "13.5.0",
    "puppeteer-core": "25.12.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@lhci/cli": {
      "lighthouse": "$lighthouse",
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "get-uri": {
        "basic-ftp": "6.2.1"
      }
    },
    "@lhci/utils": {
      "lighthouse": "$lighthouse"
    }
  }
}
